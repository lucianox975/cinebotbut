# ============================================================
# CONFIGURACIÓN DE TELEGRAM
# ============================================================
# ⚠️  El token está en .env.secrets (no incluido en Git)
# TELEGRAM_BOT_TOKEN se carga automáticamente desde .env.secrets
# Chat ID del canal/grupo/usuario a notificar (obtener con @userinfobot)
TELEGRAM_CHAT_ID=

# ============================================================
# CONFIGURACIÓN DEL MONITOR
# ============================================================
# Intervalo de ejecución en segundos (default: 300 = 5 minutos)
CHECK_INTERVAL=300

# Película objetivo para monitorear (nombre legible)
MOVIE_NAME=Avatar 3

# ============================================================
# URLS DE PELÍCULAS A MONITOREAR
# ============================================================
# Cineplanet - URL de detalle de la película
CINEPLANET_MOVIE_URL=https://www.cineplanet.cl/peliculas/avatar-fuego-y-ceniza

# Cinépolis - URL de detalle de la película
CINEPOLIS_MOVIE_URL=https://cinepolis.com/cl/pelicula/avatar-3

# Cinemark - URL de detalle de la película
CINEMARK_MOVIE_URL=https://www.cinemark.cl/pelicula/avatar-3

# ============================================================
# OPCIONES DE SCRAPING
# ============================================================
# Timeout en milisegundos para Playwright
PLAYWRIGHT_TIMEOUT=30000

# Espera extra tras cargar la página (ms) para JS dinámico
PAGE_SETTLE_MS=3000

# Modo headless (true/false)
HEADLESS=true

# Ruta del archivo de estado persistente
STATE_FILE=./data/state.json

# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
